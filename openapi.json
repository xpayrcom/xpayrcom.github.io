              "type": "string",
              "example": "ps_6b5b7d8737c0e0ec0a04a29a045d2d5d"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Poll Public On-Chain Payment Status response from XPayr Gateway API v1",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/payments/{session_id}/coupon": {
      "post": {
        "operationId": "xpayr_apply_payment_coupon",
        "summary": "Apply Checkout Discount Coupon",
        "description": "Validate and apply a merchant promotional discount coupon code to an active pending payment session.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "description": "Target payment session ID.",
            "schema": {
              "type": "string",
              "example": "ps_6b5b7d8737c0e0ec0a04a29a045d2d5d"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Apply Checkout Discount Coupon response from XPayr Gateway API v1",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "coupon_code": {
                    "type": "string",
                    "description": "Discount coupon code.",
                    "example": "XPAYR-DEMO"
                  }
                },
                "required": [
                  "coupon_code"
                ]
              }
            }
          }
        }
      }
    },
