    "/agents/{agent_id}/policy": {
      "put": {
        "operationId": "xpayr_update_ai_agent_policy",
        "summary": "Update AI Agent Spending Guardrails",
        "description": "Configure spending policy guardrails for an AI agent (max per-tx USD, daily cap, auto-approve threshold, allowed chains/tokens).",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "description": "Target AI agent public ID.",
            "schema": {
              "type": "string",
              "example": "agt_01HXYZ"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Update AI Agent Spending Guardrails response from XPayr Gateway API v1",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "max_tx_amount": {
                    "type": "number",
                    "description": "Maximum single transaction USD amount.",
                    "example": 100
                  },
                  "daily_limit_amount": {
                    "type": "number",
                    "description": "Maximum daily cumulative USD spend.",
                    "example": 500
                  },
                  "auto_approve_under": {
                    "type": "number",
                    "description": "Auto-approve threshold in USD.",
                    "example": 25
                  }
                }
              }
            }
          }
        }
      }
    },
