                            "raw": "{\n    \"amount\": 49.9,\n    \"currency\": \"USDT\",\n    \"network\": \"tron-mainnet\",\n    \"order_id\": \"ORD-1001\",\n    \"description\": \"Pro SaaS Annual Plan\",\n    \"is_multi_chain\": true,\n    \"is_reusable\": false,\n    \"send_invoice_email\": true,\n    \"customer_email\": \"buyer@example.com\",\n    \"ipn_callback_url\": \"https://example.com/webhooks/xpayr\"\n}",
